# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets

# One named account per staff member -> the audit trail shows who changed what
[admins]
hod_comp = "choose-a-strong-password"
academic_office = "choose-another-password"

# Optional: e-mail the student their PDF and every status change
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "portal@your-college.edu"
SMTP_PASSWORD = "app-password"
SMTP_FROM = "Academic Office <portal@your-college.edu>"
HELPDESK_EMAIL = "academic-office@your-college.edu"
